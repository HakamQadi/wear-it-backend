# Application
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Database
MONGODB_URI=mongodb://localhost:27017/wear_it

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Where uploaded and generated media is stored (default: ./uploads).
# Always point a test or throwaway instance at its own directory: isolating the database
# alone is not enough, because two instances sharing this folder can delete each other's files.
UPLOADS_DIR=./uploads

# Media storage on ImageKit. Set all three and uploads, imports and generated looks go to
# ImageKit instead of UPLOADS_DIR; leave any of them blank and local disk is used. Stored
# values stay /uploads/<filename> either way, and GET /uploads/<filename> redirects to the
# CDN copy. Copy existing files across first with:
#   node --env-file=.env scripts/migrate-media-to-imagekit.mjs
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Folder holding every Wear It upload (default: wear-it).
IMAGEKIT_FOLDER=wear-it

# Image import from a link.
# Loopback is refused by default. Set this to true ONLY to let the end-to-end suite import
# from its own local test server; every other private range stays blocked either way.
IMAGE_IMPORT_ALLOW_LOOPBACK=false

# AI look generation
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2

# Initial admin account (created only when no matching admin exists)
ADMIN_EMAIL=admin@wearit.local
ADMIN_PASSWORD=WearIt123!
