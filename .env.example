# Application
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001
BILLING_FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/wear_it

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

UPLOADS_DIR=./uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=wear-it
IMAGE_IMPORT_ALLOW_LOOPBACK=false

# AI look generation
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2

# Stripe subscriptions. Configure both values before paid checkout is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Test-only override; production should keep Stripe's official API endpoint.
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Initial admin account
ADMIN_EMAIL=admin@wearit.local
ADMIN_PASSWORD=WearIt123!
