# Application
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Database
MONGODB_URI=mongodb://localhost:27017/wear_it

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Where uploaded and generated media is stored (default: ./uploads).
UPLOADS_DIR=./uploads

# Media storage on ImageKit.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=wear-it

# Image import from a link.
IMAGE_IMPORT_ALLOW_LOOPBACK=false

# AI look generation
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2

# Stripe billing. Both secret values are required before Pro checkout is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override used by automated QA; production should leave this unset.
STRIPE_API_BASE_URL=

# Initial admin account (created only when no matching admin exists)
ADMIN_EMAIL=admin@wearit.local
ADMIN_PASSWORD=WearIt123!
